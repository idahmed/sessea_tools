{
  "name": "sessea-tools",
  "compatibility_date": "2026-10-15",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    // Every page is prerendered to its own .html file. Unknown URLs get dist/404.html
    // with a real 404 status instead of the home page with status 200.
    "not_found_handling": "404-page",
    // /about serves about.html, /about/ redirects to /about.
    "html_handling": "auto-trailing-slash"
  }
}
